{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": ["apps/api/src/**/*", "src/**/*", "lib/**/*", "api/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "apps/web"]
}
